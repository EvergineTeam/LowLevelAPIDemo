#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct PS_out
{
    float4 out_var_SV_Target [[color(0)]];
};

struct PS_in
{
    float3 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment PS_out PS(PS_in in [[stage_in]], texturecube<float> CubeTexture [[texture(0)]], sampler Sampler [[sampler(0)]])
{
    PS_out out = {};
    out.out_var_SV_Target = CubeTexture.sample(Sampler, in.in_var_TEXCOORD0);
    return out;
}

