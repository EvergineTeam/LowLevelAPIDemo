#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Matrices
{
    float4x4 worldViewProj;
};

struct VS_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct VS_in
{
    float3 in_var_POSITION [[attribute(0)]];
};

vertex VS_out VS(VS_in in [[stage_in]], constant type_Matrices& Matrices [[buffer(0)]])
{
    VS_out out = {};
    out.gl_Position = Matrices.worldViewProj * float4(in.in_var_POSITION, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_POSITION;
    return out;
}

